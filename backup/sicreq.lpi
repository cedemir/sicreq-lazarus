<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="SICREQ"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="frce"/>
      </Item>
      <Item>
        <PackageName Value="zcomponent"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="sicreq.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src\udm.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="DM"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="DataModule"/>
        <UnitName Value="uDM"/>
      </Unit>
      <Unit>
        <Filename Value="src\udefinicoes.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uDefinicoes"/>
      </Unit>
      <Unit>
        <Filename Value="src\uconfig.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uConfig"/>
      </Unit>
      <Unit>
        <Filename Value="src쫚stro.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uCadastro"/>
      </Unit>
      <Unit>
        <Filename Value="src\urelatorios.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uRelatorios"/>
      </Unit>
      <Unit>
        <Filename Value="src\uprincipal.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="FrmPrincipal"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="uPrincipal"/>
      </Unit>
      <Unit>
        <Filename Value="src\utema.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uTema"/>
